<%- include('partials/head', { title: 'Your space — Stillroom' }) %>
<body><div class="ambient-scene" aria-hidden="true"><span class="ambient-orb orb-one"></span><span class="ambient-orb orb-two"></span><span class="ambient-ring ring-one"></span><span class="ambient-file float-one"><b>PDF</b><i></i><i></i><i></i></span><span class="ambient-file float-two"><b>PHOTO</b><i></i><i></i></span><span class="ambient-spark spark-one">✳</span><span class="ambient-spark spark-two">✦</span></div><div class="shell">
  <aside class="sidebar"><a class="brand" href="/"><span class="brand-mark">S</span><span>stillroom<span class="brand-dot">.</span></span></a>
    <div class="side-label">YOUR SPACE</div><nav class="side-nav"><a class="nav-item active" href="#files"><span class="nav-icon">▤</span> Your files <span class="nav-count"><%= files.length %></span></a><a class="nav-item" href="#drive"><span class="nav-icon">↗</span> Drive links <span class="nav-count"><%= links.length %></span></a></nav>
    <div class="sidebar-bottom"><div class="storage-card"><div class="storage-orb">✳</div><div><strong>A little room<br>to breathe.</strong><span>Your own quiet corner.</span></div></div><div class="profile-row"><div class="avatar">M</div><div class="profile-name"><strong><%= vaultUsername %></strong><span>Private space</span></div><form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="icon-button" aria-label="Sign out" title="Sign out">↗</button></form></div></div>
  </aside>
  <main class="main-content"><header class="topbar"><div class="crumb">YOUR SPACE <span>/</span> OVERVIEW</div><div class="topbar-right"><span class="secure-label"><i></i> PRIVATE &amp; SECURE</span><div class="top-avatar">M</div></div></header>
    <section class="welcome-row"><div><div class="eyebrow"><span class="status-dot"></span> YOUR PERSONAL ARCHIVE</div><h1>Keep what <em>matters.</em></h1><p class="welcome-copy">Welcome back, <%= vaultUsername %>. Your important things are right where you left them.</p></div><button class="button primary" data-open="upload-dialog"><span class="plus">＋</span> Add a file</button></section>
    <% if (message) { %><div class="messages"><div class="alert"><%= message %></div></div><% } %><% if (error) { %><div class="messages"><div class="alert error"><%= error %></div></div><% } %>
    <section class="stats-row"><article class="stat-card glass"><span class="stat-icon lavender">▤</span><div><span class="stat-label">SAVED FILES</span><strong><%= files.length %></strong></div><span class="stat-note">in your space</span></article><article class="stat-card glass"><span class="stat-icon mint">↗</span><div><span class="stat-label">DRIVE SHORTCUTS</span><strong><%= links.length %></strong></div><span class="stat-note">ready when you are</span></article><article class="stat-card glass stat-quote"><span class="quote-star">✳</span><p>“The things we keep<br>tell our story.”</p><span>YOUR SPACE, YOUR WAY</span></article></section>
    <section id="files" class="content-section"><div class="section-heading"><div><div class="eyebrow">THE IMPORTANT THINGS</div><h2>Your files <span class="soft-count"><%= files.length %></span></h2></div><a class="text-link" href="#files">YOUR LIBRARY <span>↗</span></a></div>
      <form class="search-bar" method="get" action="/"><span>⌕</span><input type="search" name="q" value="<%= query %>" placeholder="Find a file, note or link…"><button type="submit">Search</button><% if (query) { %><a href="/" class="clear-search">Clear</a><% } %></form>
      <% if (files.length) { %><div class="file-grid"><% files.forEach((file) => { const ext = path.extname(file.name).toLowerCase(); const isPdf = ext === '.pdf'; const isImage = ['.png','.jpg','.jpeg','.webp'].includes(ext); %><article class="file-card glass"><div class="file-card-top"><div class="file-type <%= isPdf ? 'pdf' : 'file-generic' %>"><span><%= isPdf ? 'PDF' : (isImage ? 'IMG' : ext.slice(1).toUpperCase() || 'FILE') %></span></div><form method="post" action="/files/<%= encodeURIComponent(file.id) %>/delete" onsubmit="return confirm('Remove this file from your space?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="more-button" title="Remove file" aria-label="Remove file">···</button></form></div><h3><%= file.title %></h3><p class="file-filename"><%= file.name %></p><% if (file.note) { %><p class="file-note"><%= file.note %></p><% } %><div class="file-meta"><span><%= new Date(file.uploadedAt).toLocaleDateString('en', {month:'short', day:'numeric', year:'numeric'}) %></span><span><%= file.size < 1048576 ? `${Math.max(1, Math.round(file.size/1024))} KB` : `${(file.size/1048576).toFixed(1)} MB` %></span></div><a class="file-action" href="/files/<%= encodeURIComponent(file.id) %>/<%= isPdf ? 'preview' : 'open' %>" <% if (isPdf) { %>data-preview-url="/files/<%= encodeURIComponent(file.id) %>/open" data-preview-title="<%= file.title %>"<% } %>><%= isPdf ? 'Quick preview' : 'Open file' %> <span>↗</span></a></article><% }) %></div>
      <% } else { %><div class="empty-state glass"><div class="empty-illustration">✳</div><h3><%= query ? 'Nothing found just yet.' : 'Your space is ready.' %></h3><p><%= query ? 'Try another search, or clear it to see everything.' : 'Drop in a document, a photo, anything you’d like to keep close.' %></p><% if (!query) { %><button class="button secondary" data-open="upload-dialog">Add your first file <span>＋</span></button><% } %></div><% } %>
    </section>
    <section id="drive" class="content-section drive-section"><div class="section-heading"><div><div class="eyebrow">ONE CLICK AWAY</div><h2>Drive shortcuts <span class="soft-count"><%= links.length %></span></h2></div><button class="button secondary small" data-open="link-dialog"><span class="plus">＋</span> Add a link</button></div><p class="section-subtitle">Keep your cloud folders close. Add a Drive link and jump straight in whenever you need it.</p>
      <% if (links.length) { %><div class="link-list"><% links.forEach((link) => { %><article class="link-card glass"><div class="link-symbol">↗</div><div class="link-info"><h3><%= link.title %></h3><p><%= link.note || link.url %></p></div><form method="post" action="/links/<%= encodeURIComponent(link.id) %>/delete" onsubmit="return confirm('Remove this shortcut?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="more-button" aria-label="Remove shortcut">···</button></form><a class="link-open" href="<%= link.url %>" target="_blank" rel="noopener noreferrer">Get data <span>↗</span></a></article><% }) %></div>
      <% } else { %><div class="link-empty glass"><div class="link-empty-icon">↗</div><div><h3>Your Drive, a click away.</h3><p>Save a shared folder or photo link here for quick access.</p></div><button class="button secondary small" data-open="link-dialog">Add a link <span>＋</span></button></div><% } %>
    </section><footer class="footer"><span>STILLROOM <i>·</i> A SPACE OF YOUR OWN</span><span>KEEP WHAT MATTERS, CLOSE.</span></footer>
  </main>
</div>
<dialog class="modal glass" id="upload-dialog"><form method="dialog" class="modal-close-row"><button class="close-button" aria-label="Close">×</button></form><div class="modal-kicker">ADD TO YOUR SPACE</div><h2>Keep it close<span class="brand-dot">.</span></h2><p class="muted">Choose a file you want to have close at hand.</p><form method="post" enctype="multipart/form-data" action="/files" class="stack-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Give it a name<input class="field-input" name="title" maxlength="160" placeholder="e.g. Passport scan"></label><label>Choose a file<input class="field-input" type="file" name="file" accept=".pdf,.png,.jpg,.jpeg,.webp,.txt,.doc,.docx,.xls,.xlsx,.zip" required><small>PDF, images, documents and ZIP files · up to <%= uploadLimit %></small></label><label>Add a note<textarea class="field-input" name="note" rows="3" maxlength="500" placeholder="A note to help you find it later"></textarea></label><button class="button primary full" type="submit">Save to my space <span>↗</span></button></form></dialog>
<dialog class="modal glass" id="link-dialog"><form method="dialog" class="modal-close-row"><button class="close-button" aria-label="Close">×</button></form><div class="modal-kicker">SAVE A SHORTCUT</div><h2>One click away<span class="brand-dot">.</span></h2><p class="muted">Add a Drive link to a folder, photo or file.</p><form method="post" action="/links" class="stack-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>What should we call it?<input class="field-input" name="title" maxlength="160" required placeholder="e.g. Family photos"></label><label>Paste the link<input class="field-input" type="url" name="url" maxlength="1000" required placeholder="https://drive.google.com/..."></label><label>Any note?<input class="field-input" name="note" maxlength="240" placeholder="Optional note"></label><button class="button primary full" type="submit">Save shortcut <span>↗</span></button></form></dialog>
<dialog class="preview-modal" id="preview-dialog"><div class="preview-header"><div><span class="preview-pdf-tag">PDF</span><strong id="preview-title">Document preview</strong></div><form method="dialog"><button class="close-button preview-close" aria-label="Close preview">×</button></form></div><iframe title="PDF preview" id="preview-frame"></iframe></dialog>
<script src="/vault/app.js"></script></body></html>
